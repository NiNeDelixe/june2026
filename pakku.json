{
    "name": "june2026",
    "version": "DEV",
    "description": "A template pack",
    "author": "Nanleb",
    "overrides": [
        "config",
        "defaultconfigs",
        "kubejs",
        "!kubejs/probe/**"
    ],
    "server_overrides": [
        "!kubejs/assets",
        "forge-auto-install.txt",
        "generate_auto_installation_file.bat",
        "minecraft_server.jar",
        "server.properties",
        "server_starter.conf",
        "server-icon.png",
        "start_server.bat",
        "README.md"
    ],
    "client_overrides": [
        "resourcepacks"
    ],
    "projects": {
        "chunky": {
            "side": "SERVER"
        },
        "create": {
            "side": "BOTH"
        },
        "what-are-they-up-to": {
            "side": "CLIENT"
        },
        "mob-sunscreen": {
            "redistributable": true
        },
        "plushie-buddies": {
            "redistributable": true
        },
        "entityculling": {
            "redistributable": true
        },
        "no-enchant-glint": {
            "redistributable": true
        },
        "no-potion-particles": {
            "redistributable": true
        },
        "ragdoll-reactions": {
            "redistributable": true
        },
        "bookshelf": {
            "side": "BOTH"
        },
        "insanelib": {
            "side": "BOTH"
        },
        "sodium": {
            "side": "CLIENT"
        },
        "the-lost-cities": {
            "side": "BOTH"
        },
        "sodium-options-api": {
            "side": "CLIENT",
            "update_strategy": "NONE"
        },
        "probejs": {
            "side": "CLIENT",
            "update_strategy": "NONE",
            "export": false
        },
        "cool-rain": {
            "redistributable": true
        },
        "fastboot": {
            "redistributable": true
        },
        "data-anchor": {
            "side": "BOTH",
            "update_strategy": "NONE"
        }
    },
    "export_server_side_projects_to_client": false
}